H  -1.900000   0.890000  -1.110000
H  -1.900000  -0.890000  -1.110000
H  -2.580000   0.000000   0.230000
$end

$rem
JOBTYPE          opt
METHOD           b3lyp
BASIS            6-311+G(d,p)
SOLVENT_METHOD   pcm
$end

$pcm
THEORY    cpcm
METHOD    SWIG
SOLVER    INVERSION
$end

$solvent
Dielectric    78.39
$end

